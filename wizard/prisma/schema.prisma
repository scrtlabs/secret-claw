generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PortalLink {
  id           String   @id @default(cuid())
  userSub      String   @unique
  email        String?
  apiKeyCipher String
  balance      Float    @default(0)
  linkedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnthropicKey {
  id        String   @id @default(cuid())
  userSub   String
  name      String
  keyCipher String
  // Last 4 chars of the plaintext key, for display (e.g. "ab12"). Never the full key.
  keyHint   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userSub, name])
  @@index([userSub])
}

model User {
  id                       String        @id @default(cuid())
  email                    String        @unique
  sub                      String        @unique
  passwordHash             String?
  admin                    Boolean       @default(false)
  emailConfirmed           Boolean       @default(false)
  emailConfirmationToken   String?       @unique
  emailConfirmationExpires DateTime?
  passwordResetToken       String?       @unique
  passwordResetExpires     DateTime?
  createdAt                DateTime      @default(now())
  lastLogin                DateTime      @updatedAt
  agents                   Agent[]       @relation("UserAgents")
  subscription             Subscription?
}

// An admin-issued code that grants a free subscription for `durationDays`.
model Promocode {
  id             String    @id @default(cuid())
  // Stored uppercased; matched case-insensitively at redemption.
  code           String    @unique
  description    String?
  // Days of free Pro access granted on redemption.
  durationDays   Int       @default(30)
  // Total redemptions allowed across all users; null = unlimited.
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions    PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promocodeId String
  userSub     String
  code        String
  createdAt   DateTime  @default(now())

  promocode   Promocode @relation(fields: [promocodeId], references: [id], onDelete: Cascade)

  @@unique([promocodeId, userSub])
  @@index([userSub])
}

model Subscription {
  id                      String    @id @default(cuid())
  userSub                 String    @unique
  bluesnapSubscriptionId  String    @unique
  bluesnapVaultedShopperId String?
  planId                  String
  // trialing | active | past_due | canceled
  status                  String
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                    User      @relation(fields: [userSub], references: [sub])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Agent {
  id                  String    @id @default(cuid())
  deploymentId        String    @unique
  userSub             String
  status              String
  runtime             String
  tier                String
  secretaiModel       String?
  vmId                String?
  vmHostname          String?
  jobId               String?
  gatewayToken        String?
  telegramEnabled     Boolean   @default(false)
  telegramBotUsername String?
  errorMessage        String?
  createdAt           DateTime
  provisionedAt       DateTime?
  updatedAt           DateTime  @updatedAt

  user                User      @relation("UserAgents", fields: [userSub], references: [sub])

  @@index([userSub])
}
